
/*
 * Generate Hyperlambda code
 *
 * This function allows you to generate Hyperlambda code. The [query] argument must be the description of what code you want.
 */
.arguments

   // Mandatory argument describing the Hyperlambda code you want to generate.
   query:string

   // Optional argument being code you want the AI function to change.
   old_code:string

   // Optional argument being override for system message.
   system_message_override:string

try

   // Sanity checking invocation.
   validators.mandatory:x:@.arguments/*/query

   // Retrieving OpenAI API token from configuration settings.
   .token
   set-value:x:@.token
      strings.concat
         .:"Bearer "
         config.get:"magic:openai:key"

   // Checking if caller provided [old_code] that needs to be modified.
   if
      and
         exists:x:@.arguments/*/old_code
         not-null:x:@.arguments/*/old_code
      .lambda

         // Adding [context].
         unwrap:x:+/*/*/*
         insert-after:x:../*/while/*/.lambda/*/http.post/*/payload/*/messages/0
            .
               .
                  role:user
                  content:x:@.arguments/*/old_code

   // Loading system instruction.
   .instruction
   if
      and
         exists:x:@.arguments/*/system_message_override
         not-null:x:@.arguments/*/system_message_override
      .lambda
         set-value:x:@.instruction
            get-value:x:@.arguments/*/system_message_override
   else
      set-value:x:@.instruction
         io.file.load:/modules/hyperlambda-generator/system-instruction.md

   // Generating, verifying the result parses as Hyperlambda, and retrying up to 3 times.
   .attempt:int:0
   .ok:bool:false
   .completion
   while
      and
         eq:x:@.ok
            .:bool:false
         lt:x:@.attempt
            .:int:3
      .lambda

         // First attempt is deterministic, retries explore with a higher temperature.
         math.increment:x:@.attempt
         .temperature:decimal:0.0
         if
            mt:x:@.attempt
               .:int:1
            .lambda
               set-value:x:@.temperature
                  .:decimal:0.5

         // Invokes OpenAI.
         http.post:"https://api.openai.com/v1/chat/completions"
            convert:bool:true
            timeout:int:45
            headers
               Authorization:x:@.token
               Content-Type:application/json
            payload
               model:"ft:gpt-4.1-mini-2025-04-14:ainiro:hl:Dz01Y5qD"
               max_tokens:int:4096
               temperature:x:@.temperature
               top_p:decimal:1
               messages
                  .
                     role:system
                     content:x:@.instruction
                  .
                     role:user
                     content:x:@.arguments/*/query

         // Sanity checking above invocation.
         if
            not
               and
                  mte:x:@http.post
                     .:int:200
                  lt:x:@http.post
                     .:int:300
            .lambda

               // Oops, error - Logging error and throwing to caller.
               log.error:Something went wrong while invoking OpenAI
                  message:x:@http.post/*/content/*/error/*/message
                  status:x:@http.post
               throw:Something went wrong while invoking OpenAI
                  message:x:@http.post/*/content/*/error/*/message
                  status:x:@http.post

         /*
          * Removing Markdown code fences if the model added any, trimming, and verifying
          * the result actually parses as Hyperlambda before accepting it - retrying otherwise.
          */
         try
            strings.replace:x:@http.post/*/content/*/choices/0/*/message/*/content
               .:"```hyperlambda"
               .:
            strings.replace:x:@strings.replace
               .:"```"
               .:
            strings.trim:x:@strings.replace
            hyper2lambda:x:@strings.trim
            if
               not-exists:x:@hyper2lambda/*
               .lambda
                  throw:Empty completion

            // Verifying every slot at the root and inside [.lambda] blocks actually exists.
            hyperlambda.verify-slots:x:@strings.trim
            if
               eq:x:@hyperlambda.verify-slots
                  .:bool:false
               .lambda
                  strings.join:x:@hyperlambda.verify-slots/*
                     .:", "
                  strings.concat
                     .:"Generated Hyperlambda references non-existing slots: "
                     get-value:x:@strings.join
                  throw:x:@strings.concat

            set-value:x:@.completion
               get-value:x:@strings.trim
            set-value:x:@.ok
               .:bool:true
         .catch
            log.info:Generated Hyperlambda failed verification, retrying
               attempt:x:@.attempt
               error:x:@.arguments/*/message

   // Verifying we ended up with code that parses.
   if
      eq:x:@.ok
         .:bool:false
      .lambda

         // Oops ...!!
         log.error:Model could not produce parseable Hyperlambda
            prompt:x:@.arguments/*/query
         throw:Could not generate valid Hyperlambda
            status:int:502
            public:bool:true

   /*
    * Replacing any comment the model produced with a single top-level file comment holding
    * the exact prompt: parsing WITH comments so a leading model comment can be dropped, then
    * inserting the prompt as the file comment before re-serializing.
    */
   hyper2lambda:x:@.completion
      comments:true
   if
      eq
         get-name:x:@hyper2lambda/0
         .:..
      .lambda
         remove-nodes:x:@hyper2lambda/0
   unwrap:x:+/*/*
   insert-before:x:@hyper2lambda/0
      .
         ..:x:@.arguments/*/query
   lambda2hyper:x:@hyper2lambda/*
      comments:true
   set-value:x:@.completion
      strings.trim:x:@lambda2hyper

   // Storing prompt/completion into our database.
   data.connect:hyperlambda-generator
      data.create
         table:requests
         values
            prompt:x:@.arguments/*/query
            completion:x:@.completion

   // Returns the result of your last action.
   yield
      new_code:x:@.completion

.catch

   // Logging and passing the error on to caller, preserving its status code.
   log.error:x:@.arguments/*/message
      status:x:@.arguments/*/status
   get-first-value
      get-value:x:@.arguments/*/status
      .:int:500
   throw:x:@.arguments/*/message
      status:x:@get-first-value
      public:bool:true

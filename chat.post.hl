
/*
 * Gen-AI endpoint generating or changing Hyperlambda code from prompts
 *
 * Executes synchronously and returns the response. Supply [data] being existing code to change it
 * rather than generate something new, at which point [prompt] describes only the change.
 */
.arguments
   prompt:string
   data:string

/*
 * Throttling invocations to 50 per hour per IP address, since this endpoint is public
 * and consumes the OpenAI API key of whoever installed the backend. The declaration is
 * idempotent, keeping the existing counter as long as its configuration is unchanged, and
 * the counter is kept in memory, implying a backend restart resets it.
 */
execution.throttle.create:hyperlambda-generator.chat.ip
   limit:50
   window:3600
   per:ip
execution.throttle:hyperlambda-generator.chat.ip

// Forwarding heavy lifting to workflow file.
if
   and
      exists:x:@.arguments/*/data
      not-null:x:@.arguments/*/data
   .lambda
      unwrap:x:+/*/*
      add:x:../*/execute-file
         .
            old_code:x:@.arguments/*/data
execute-file:"/modules/hyperlambda-generator/workflows/generate-hyperlambda.hl"
   query:x:@.arguments/*/prompt

// Returns the result of your last action.
yield
   result:x:@execute-file/*/new_code
   finish_reason:stop

